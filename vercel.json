{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "invite", "value": "garage" },
        { "type": "query", "key": "source", "value": "friend_invite" }
      ],
      "destination": "/Join-Team-Roadex",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/battle/:id", "destination": "/battle.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/feedback", "destination": "/feedback.html" },
    { "source": "/feedback-admin", "destination": "/feedback-admin.html" },
    { "source": "/Join-Team-Roadex", "destination": "/join-test.html" },
    { "source": "/join-test", "destination": "/join-test.html" }
  ]
}
